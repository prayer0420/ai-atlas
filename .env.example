SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=local
# Local worker only. Local mode never falls back to a paid provider.
OLLAMA_MODEL=qwen3.5:4b
ATLAS_VAULT_PATH=
ATLAS_INBOX_PATH=
OPENAI_API_KEY=
# Image generation is independent from the text AI provider; selected per card brief.
# Local ComfyUI only. Bind it to 127.0.0.1, never expose it publicly.
ATLAS_COMFYUI_PORT=8188
# Optional: Vercel production uses its automatic OIDC identity without this key.
AI_GATEWAY_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Comma-separated email allowlist. Required for AI analysis in production.
ALLOWED_EMAILS=
DAILY_ANALYSIS_LIMIT=20
# Private server-to-server token for the two Vercel cron endpoints.
CRON_SECRET=
